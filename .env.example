# Chess Coach environment example
# Copy to `.env` and change values for your machine.
# Never commit your real `.env`.

# Application mode: development, production, or testing.
APP_ENV=development

# Required in production. Use a long random value, 24+ characters.
APP_SECRET_KEY=change-me-use-a-long-random-secret

# Required in production. Protects admin/mutating/AI endpoints via `X-ADMIN-TOKEN`.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# First-party login/session flow.
# Generate ADMIN_PASSWORD_HASH with:
# python3 -c "from api.auth_service import create_password_hash; import getpass; print(create_password_hash(getpass.getpass('Admin password: ')))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_COOKIE_NAME=chess_coach_session
SESSION_TTL_SECONDS=43200

# Chess.com username to sync/analyze.
CHESS_USERNAME=Tushar9038

# Public hosts accepted by TrustedHostMiddleware.
# Comma-separated. In production, set this to your real domain(s).
ALLOWED_HOSTS=localhost,127.0.0.1,personalvm.duckdns.org

# Browser origins allowed by CORS.
# Comma-separated full origins. In production, set only your HTTPS origin(s).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://personalvm.duckdns.org

# Enable debug endpoints under `/api/debug/*`.
# Keep false unless actively troubleshooting on a protected environment.
ENABLE_DEBUG_ROUTES=false

# Request and queue safety.
JOB_QUEUE_MAX_SIZE=100
MAX_REQUEST_BODY_BYTES=1048576

# Rate limiting backend:
# - sqlite: survives process restarts and works better for a self-hosted service
# - memory: simpler, per-process only
RATE_LIMIT_BACKEND=sqlite

# Runtime binding. The current config uses constants for host/port defaults.
# Keep these documented for service files or future config expansion.
APP_HOST=0.0.0.0
APP_PORT=8000

# External/local services.
# Ollama should normally stay bound to localhost, not the public internet.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=chess-coach
OLLAMA_MODEL_FAST=chess-coach-fast

# Stockfish settings. The current code defaults to these values in config.py.
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_DEPTH=18
STOCKFISH_THREADS=3
STOCKFISH_HASH_MB=256
