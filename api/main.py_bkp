# api/main.py
from fastapi import FastAPI, BackgroundTasks, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import sqlite3
from pathlib import Path

from sync.fetch_games import sync_all
from engine.stockfish_worker import run_analysis_worker
from drills.srs_scheduler import get_due_items, record_result, populate_srs_from_mistakes
from coach.ollama_client import generate_game_report, chat

DB_PATH = Path("~/chess-coach/data/chess.db").expanduser()
app = FastAPI(title="Chess Coach API")

app.add_middleware(CORSMiddleware, allow_origins=["*"],
                   allow_methods=["*"], allow_headers=["*"])

def get_db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn

# ── DASHBOARD ─────────────────────────────────────────────────────
@app.get("/api/stats")
def get_stats():
    conn = get_db()
    profile = conn.execute("SELECT * FROM player_profile WHERE id=1").fetchone()

    rating_history = conn.execute("""
        SELECT date(date) as d, opponent_rating,
               CASE WHEN color='white' THEN white_rating ELSE black_rating END as rating
        FROM games ORDER BY date DESC LIMIT 50
    """).fetchall()

    mistake_breakdown = conn.execute("""
        SELECT type, COUNT(*) as count
        FROM mistakes m
        JOIN games g ON m.game_id = g.id
        WHERE g.date > datetime('now', '-30 days')
        GROUP BY type ORDER BY count DESC
    """).fetchall()

    weekly_accuracy = conn.execute("""
        SELECT strftime('%W', date) as week,
               AVG(CASE WHEN result='win' THEN 1.0 ELSE 0.0 END) as win_rate,
               COUNT(*) as games
        FROM games
        GROUP BY week ORDER BY week DESC LIMIT 8
    """).fetchall()

    due_count = conn.execute(
        "SELECT COUNT(*) FROM srs_items WHERE due_date <= date('now')"
    ).fetchone()[0]

    conn.close()
    return {
        "profile": dict(profile) if profile else {},
        "rating_history": [dict(r) for r in rating_history],
        "mistake_breakdown": [dict(m) for m in mistake_breakdown],
        "weekly_stats": [dict(w) for w in weekly_accuracy],
        "drills_due": due_count,
    }

# ── GAMES ─────────────────────────────────────────────────────────
@app.get("/api/games")
def list_games(limit: int = 20, offset: int = 0):
    conn = get_db()
    games = conn.execute("""
        SELECT g.id, g.date, g.color, g.result, g.opening_name,
               g.opponent_rating, g.analyzed,
               COUNT(m.id) as mistake_count,
               j.coach_note
        FROM games g
        LEFT JOIN mistakes m ON m.game_id = g.id
        LEFT JOIN journal_entries j ON j.game_id = g.id
        GROUP BY g.id
        ORDER BY g.date DESC
        LIMIT ? OFFSET ?
    """, (limit, offset)).fetchall()
    conn.close()
    return [dict(g) for g in games]

@app.get("/api/games/{game_id}")
def get_game(game_id: str):
    conn = get_db()
    game = conn.execute("SELECT * FROM games WHERE id=?", (game_id,)).fetchone()
    if not game:
        raise HTTPException(404, "Game not found")
    moves = conn.execute(
        "SELECT * FROM moves WHERE game_id=? ORDER BY ply", (game_id,)
    ).fetchall()
    mistakes = conn.execute(
        "SELECT * FROM mistakes WHERE game_id=? ORDER BY eval_loss DESC", (game_id,)
    ).fetchall()
    journal = conn.execute(
        "SELECT * FROM journal_entries WHERE game_id=?", (game_id,)
    ).fetchone()
    conn.close()
    return {
        "game": dict(game),
        "moves": [dict(m) for m in moves],
        "mistakes": [dict(m) for m in mistakes],
        "journal": dict(journal) if journal else None,
    }

# ── DRILL (SRS) ───────────────────────────────────────────────────
@app.get("/api/drills/due")
def get_due_drills():
    return get_due_items(limit=15)

class DrillResult(BaseModel):
    item_id: int
    quality: int  # 0-3

@app.post("/api/drills/result")
def submit_drill_result(result: DrillResult):
    record_result(result.item_id, result.quality)
    return {"status": "ok"}

# ── COACHING ──────────────────────────────────────────────────────
@app.post("/api/coach/game/{game_id}")
def generate_report(game_id: str, background_tasks: BackgroundTasks):
    def _generate_and_store():
        report = generate_game_report(game_id)
        conn = sqlite3.connect(DB_PATH)
        conn.execute("""
            INSERT INTO journal_entries (game_id, summary_md, coach_note)
            VALUES (?, ?, ?)
            ON CONFLICT(game_id) DO UPDATE SET coach_note=excluded.coach_note
        """, (game_id, report, report))
        conn.commit()
        conn.close()
    background_tasks.add_task(_generate_and_store)
    return {"status": "generating"}

class ChatMessage(BaseModel):
    message: str
    history: list[dict] = []

@app.post("/api/coach/chat")
def coach_chat(body: ChatMessage):
    messages = body.history + [{"role": "user", "content": body.message}]
    reply = chat(messages)
    return {"reply": reply}

# ── SYNC & ANALYSIS ───────────────────────────────────────────────
@app.post("/api/sync")
def trigger_sync(background_tasks: BackgroundTasks):
    background_tasks.add_task(sync_all, False)
    return {"status": "sync started"}

@app.post("/api/analyze")
def trigger_analysis(background_tasks: BackgroundTasks):
    background_tasks.add_task(run_analysis_worker)
    return {"status": "analysis started"}

@app.get("/api/analysis/progress")
def analysis_progress():
    conn = get_db()
    result = conn.execute("""
        SELECT
          SUM(CASE WHEN analyzed=1 THEN 1 ELSE 0 END) as done,
          SUM(CASE WHEN analyzed=0 THEN 1 ELSE 0 END) as pending,
          COUNT(*) as total
        FROM games
    """).fetchone()
    conn.close()
    return dict(result)
