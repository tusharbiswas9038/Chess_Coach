# coach/prompt_builder.py
import sqlite3, json
from pathlib import Path

DB_PATH = Path("~/chess-coach/data/chess.db").expanduser()

def build_game_context(game_id: str) -> dict:
    """Pull all relevant data for one game into a structured dict."""
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row

    game = conn.execute("SELECT * FROM games WHERE id=?", (game_id,)).fetchone()
    if not game:
        return {}

    mistakes = conn.execute("""
        SELECT type, phase, fen, played_move, best_move, eval_loss, is_critical
        FROM mistakes WHERE game_id=?
        ORDER BY eval_loss DESC
    """, (game_id,)).fetchall()

    profile = conn.execute("SELECT * FROM player_profile WHERE id=1").fetchone()

    # Stats from last 20 games
    recent_stats = conn.execute("""
        SELECT
          AVG(CASE WHEN result='win' THEN 1.0 ELSE 0.0 END) as win_rate,
          COUNT(*) as game_count
        FROM games
        WHERE id != ? AND date > datetime('now', '-30 days')
    """, (game_id,)).fetchone()

    conn.close()

    return {
        "game": {
            "result": game["result"],
            "color": game["color"],
            "opponent_rating": game["opponent_rating"],
            "opening": game["opening_name"],
            "time_control": game["time_control"],
        },
        "mistakes": [dict(m) for m in mistakes],
        "player": {
            "rating": profile["current_rating"] if profile else 751,
            "hanging_piece_rate": profile["hanging_piece_rate"] if profile else None,
            "blunder_per_game": profile["blunder_per_game"] if profile else None,
            "weak_phase": profile["weak_phase"] if profile else "middlegame",
        },
        "recent": dict(recent_stats) if recent_stats else {}
    }

def build_coaching_prompt(game_id: str) -> str:
    ctx = build_game_context(game_id)
    if not ctx:
        return ""

    mistakes_text = ""
    for i, m in enumerate(ctx["mistakes"][:3], 1):  # Top 3 mistakes only
        mistakes_text += f"""
Mistake {i}: {m['type'].replace('_',' ').title()}
  Phase: {m['phase']}
  Played: {m['played_move']} | Should have played: {m['best_move']}
  Eval lost: {m['eval_loss']} centipawns
  Critical moment: {'Yes' if m['is_critical'] else 'No'}
"""

    prompt = f"""
Analyze this chess game for a {ctx['player']['rating']}-rated player and write a coaching report.

GAME RESULT: {ctx['game']['color'].upper()} — {ctx['game']['result'].upper()}
OPENING: {ctx['game']['opening'] or 'Unknown'}
OPPONENT RATING: {ctx['game']['opponent_rating']}

MISTAKES THIS GAME:
{mistakes_text}

PLAYER CONTEXT:
- Hanging piece rate (past games): {ctx['player']['hanging_piece_rate']:.0%} of games
- Average blunders per game: {ctx['player']['blunder_per_game']:.1f}
- Biggest weakness: {ctx['player']['weak_phase']}

Write a coaching note in this exact format:
1. One sentence on what went well (if anything)
2. The single most important mistake to fix (be specific about the position)
3. One concrete drill or habit to practice before the next game
4. One question to ask yourself before every move

Keep it under 150 words. Use plain language — no jargon. Be direct.
"""
    return prompt.strip()
