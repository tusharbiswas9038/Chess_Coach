# coach/ollama_client.py
import httpx, json
from typing import Generator
from config import OLLAMA_URL, OLLAMA_MODEL, OLLAMA_MODEL_FAST


def generate(prompt: str, fast: bool = False) -> str:
    """
    Generate a completion.
    fast=True uses the 7B model (~25s/response).
    fast=False uses the 14B model (~250s/response) — for interactive chat only.
    """
    model = OLLAMA_MODEL_FAST if fast else OLLAMA_MODEL
    payload = {
        "model": model,
        "prompt": prompt,
        "stream": False,
        "options": {
            "temperature": 0.2,
            "top_p": 0.85,
            "num_predict": 300,
        }
    }

    if stream:
        def _stream():
            with httpx.stream("POST", f"{OLLAMA_URL}/api/generate",
                              json=payload, timeout=1800) as r:
                for line in r.iter_lines():
                    if line:
                        chunk = json.loads(line)
                        yield chunk.get("response", "")
                        if chunk.get("done"):
                            break
        return _stream()
    else:
        r = httpx.post(f"{OLLAMA_URL}/api/generate",
                       json=payload, timeout=1800)
        r.raise_for_status()
        return r.json()["response"]

def generate_game_report(game_id: str) -> str:
    from coach.prompt_builder import build_coaching_prompt
    prompt = build_coaching_prompt(game_id)
    if not prompt:
        return "Could not generate report — game not analyzed yet."
    return generate(prompt)

def chat(messages: list[dict]) -> str:
    from coach.prompt_builder import build_player_context
    context = build_player_context()

    system_msg = {
        "role": "system",
        "content": f"You are a chess coach. Here is your student's current data:\n\n{context}"
    }

    full_messages = [system_msg] + messages

    payload = {
        "model": MODEL,
        "messages": full_messages,
        "stream": False,
        "options": {"temperature": 0.25, "num_predict": 500}
    }
    r = httpx.post(f"{OLLAMA_URL}/api/chat", json=payload, timeout=1800)
    r.raise_for_status()
    return r.json()["message"]["content"]
